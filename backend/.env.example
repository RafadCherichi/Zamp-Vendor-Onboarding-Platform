# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Vendor Onboarding Platform"
VERSION=0.1.0

# Security (Generate a random 32+ character key for production)
SECRET_KEY=insecure-dev-secret-key-change-in-production-only-for-local-demo-12345
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For local development with zero dependencies:
DATABASE_URL=sqlite:///./vendor_onboarding.db
# For PostgreSQL (Docker / Local / Supabase / Neon):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/vendor_onboarding

# CORS Origins (JSON formatted array of allowed frontend URLs)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Private Object Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage_uploads
MAX_FILE_SIZE_BYTES=15728640
